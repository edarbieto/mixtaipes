# Copy to .env and adjust. Never commit .env.

# --- docker compose ---
POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
# Host ports (loopback only).
APP_PORT=8080
DB_PORT=5432

# --- local development (make run) ---
# The Go server runs on the host and connects to the compose database.
DATABASE_URL=postgres://mixtaipes:change-me@localhost:5432/mixtaipes?sslmode=disable
HTTP_ADDR=:8080
# Where the Astro dev server proxies /v1 and /healthz (make web).
API_URL=http://localhost:8080

# --- external APIs ---
# Spotify app (Development Mode is enough): client-credentials flow, Search only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Fallback market (ISO 3166-1 alpha-2) when Accept-Language has no region.
SPOTIFY_MARKET=US
# Google AI Studio API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
